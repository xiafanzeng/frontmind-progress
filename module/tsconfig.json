{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": [
    "contracts/**/*.ts",
    "schema/**/*.ts",
    "server/**/*.ts",
    "worker/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx"
  ],
  "exclude": [
    "client/**/*.test.ts",
    "client/**/*.test.tsx"
  ]
}
