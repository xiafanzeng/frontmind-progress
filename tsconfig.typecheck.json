{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "module",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "module/contracts/**/*.ts",
    "module/schema/**/*.ts",
    "module/server/**/*.ts",
    "module/worker/**/*.ts"
  ],
  "exclude": []
}
